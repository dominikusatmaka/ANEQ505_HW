LMboot <- function(data, i, mod, emformula, method = "pairwise") {
r <- residuals(mod)[i]
y <- fitted(mod) + r
x <- data
x[[all.vars(formula(mod))[1]]] <- y
if (inherits(mod, "lm"))     fit <- lm(formula(mod), data = x)
else if (inherits(mod, "glm")) fit <- glm(formula(mod), data = x,
family = mod$family)
em  <- emmeans(fit, as.formula(emformula), data = x)
con <- contrast(em, method = method)
s   <- summary(con)
out <- s$estimate
names(out) <- s$contrast
return(out)
}
weightmaker <- function(n) {
p   <- as.logical(rbinom(n, 1, (sqrt(5) + 1) / (2 * sqrt(5))))
out <- numeric(n)
out[ p] <- -(sqrt(5) - 1) / 2
out[!p] <- (sqrt(5) + 1) / 2
return(out)
}
wildfun <- function(data, i, mod, emformula, method = "pairwise") {
r <- residuals(mod)[i]
h <- hatvalues(mod)
w <- weightmaker(length(r)) / (1 - h)
y <- fitted(mod) + w * r
x <- data
x[[all.vars(formula(mod))[1]]] <- y
if (inherits(mod, "lm"))     fit <- lm(formula(mod), data = x)
else if (inherits(mod, "glm")) fit <- glm(formula(mod), data = x,
family = mod$family)
em  <- emmeans(fit, as.formula(emformula), data = x)
con <- contrast(em, method = method)
s   <- summary(con)
out <- s$estimate
names(out) <- s$contrast
return(out)
}
boot_ci_table <- function(b, R_used = NULL) {
res <- matrix(NA, length(b$t0), 2)
for (i in seq_along(b$t0))
res[i, ] <- boot.ci(b, type = "perc", index = i)$perc[, 4:5]
res <- cbind(b$t0, res)
colnames(res) <- c("Estimate", "Lower 95% CI", "Upper 95% CI")
rownames(res) <- names(b$t0)
return(round(res, 4))
}
cat("--- Semi-Parametric Bootstrap ---\n")
cat("Context: ANOVA pairwise contrasts for EEQ ~ Stress_Tertile (Day shift)\n\n")
df_day_bs <- df %>% filter(Shift == "Day", !is.na(Stress_Tertile))
aov_day_eeq <- aov(EEQ_Score ~ Stress_Tertile, data = df_day_bs)
set.seed(512)
b_semi <- boot(df_day_bs, LMboot, R = 1000,
mod = aov_day_eeq, emformula = "~ Stress_Tertile")
cat("Bootstrap results (semi-parametric, R=1000):\n")
print(boot_ci_table(b_semi))
cat("Interpretation: CIs not crossing zero indicate significant contrast\n")
df_night_bs  <- df %>% filter(Shift == "Night", !is.na(Stress_Tertile))
aov_night_eeq <- aov(EEQ_Score ~ Stress_Tertile, data = df_night_bs)
set.seed(512)
b_semi_night <- boot(df_night_bs, LMboot, R = 1000,
mod = aov_night_eeq, emformula = "~ Stress_Tertile")
cat("\nNight shift bootstrap:\n")
print(boot_ci_table(b_semi_night))
cat("\n--- Wild Bootstrap (Mammen weights) ---\n")
cat("Context: Shift difference in log(HED) after adjusting for IVs + covariates\n\n")
m_hed_full <- lm(log_HED ~ Stress_K10 + Burnout_Score + Fatigue_Score +
Age + BMI + Smoking + SleepQuality_Cat + Disease_History +
Shift, data = df)
cat("Breusch-Pagan p-value:", round(bptest(m_hed_full)$p.value, 4), "\n")
cat("If p < .05 → wild bootstrap is warranted\n\n")
set.seed(512)
b_wild <- boot(df, wildfun, R = 1000,
mod = m_hed_full, emformula = "~ Shift")
cat("Wild bootstrap — Shift difference in log(HED):\n")
print(boot_ci_table(b_wild))
# Wild bootstrap for ViscFat model
m_vis_full <- lm(log_ViscFat ~ Stress_K10 + Burnout_Score + Fatigue_Score +
Age + BMI + Smoking + SleepQuality_Cat + Disease_History +
Shift, data = df)
set.seed(512)
b_wild_vis <- boot(df, wildfun, R = 1000,
mod = m_vis_full, emformula = "~ Shift")
cat("\nWild bootstrap — Shift difference in log(ViscFat):\n")
print(boot_ci_table(b_wild_vis))
cat("\n--- Sidak-corrected Bootstrap CIs ---\n")
cat("For pairwise contrasts with m comparisons:\n")
cat("alpha_Sidak = 1 - (1 - 0.05/m)^(1/m)\n\n")
m_comp <- length(b_semi$t0)
alpha_sidak <- 1 - (1 - 0.05 / m_comp)^(1 / m_comp)
cat(sprintf("m = %d comparisons → α' = %.6f\n", m_comp, alpha_sidak))
res_sidak <- matrix(NA, m_comp, 2)
for (i in 1:m_comp)
res_sidak[i, ] <- boot.ci(b_semi, type = "perc",
index = i, conf = 1 - alpha_sidak)$perc[, 4:5]
res_sidak <- cbind(b_semi$t0, res_sidak)
colnames(res_sidak) <- c("Estimate", "Sidak Lower CI", "Sidak Upper CI")
rownames(res_sidak) <- names(b_semi$t0)
cat("Sidak-adjusted 95% CIs (Day shift, EEQ contrasts):\n")
print(round(res_sidak, 4))
drop_singleton_factors <- function(sub, covariates) {
keep <- sapply(covariates, function(v) {
x <- sub[[v]]
if (is.factor(x) || is.character(x)) {
return(length(unique(na.omit(x))) >= 2)
}
return(TRUE)
})
dropped <- covariates[!keep]
if (length(dropped) > 0)
cat("  [Note] Dropped singleton-level covariate(s):", paste(dropped, collapse = ", "), "\n")
return(covariates[keep])
}
run_within_shift_mlr <- function(dv, shift_label, data = df) {
sub <- data %>% filter(Shift == shift_label)
all_covs <- c("Age", "BMI", "Smoking", "SleepQuality_Cat", "Disease_History")
valid_covs <- drop_singleton_factors(sub, all_covs)
rhs <- paste(
c("Stress_K10", "Burnout_Score", "Fatigue_Score", valid_covs),
collapse = " + "
)
fml <- as.formula(paste(dv, "~", rhs))
m <- lm(fml, data = sub)
s <- summary(m)
cat(sprintf("%-14s | %-5s | R²=%.4f | Adj R²=%.4f\n",
dv, shift_label, s$r.squared, s$adj.r.squared))
print(tidy(m, conf.int = TRUE)[, c("term", "estimate", "std.error", "p.value")])
cat("\n")
invisible(m)
}
for (shift in c("Day", "Night")) {
cat(sprintf("\n\n====== SHIFT: %s ======\n", shift))
for (dv in DVs) {
run_within_shift_mlr(dv, shift)
}
}
extract_slope <- function(dv, iv, shift_label, data = df) {
sub      <- data %>% filter(Shift == shift_label) %>% droplevels()
all_covs <- c("Age", "BMI", "Smoking", "SleepQuality_Cat", "Disease_History")
valid_covs <- drop_singleton_factors(sub, all_covs)
rhs <- paste(c("Stress_K10", "Burnout_Score", "Fatigue_Score", valid_covs),
collapse = " + ")
m <- lm(as.formula(paste(dv, "~", rhs)), data = sub)
tidy(m) %>%
filter(term == iv) %>%
mutate(DV = dv, IV = iv, Shift = shift_label) %>%
dplyr::select(DV, IV, Shift, estimate, std.error, p.value)
}
slope_table <- bind_rows(
lapply(DVs, function(dv)
bind_rows(
lapply(IVs, function(iv)
bind_rows(
extract_slope(dv, iv, "Day"),
extract_slope(dv, iv, "Night")
)
)
)
)
) %>%
mutate(across(c(estimate, std.error, p.value), round, 4),
Sig = ifelse(p.value < .05, "*", ""))
cat("Regression slopes (β) for each IV → DV combination, by Shift:\n")
cat("(* = p < .05)\n\n")
print(as.data.frame(slope_table), row.names = FALSE)
