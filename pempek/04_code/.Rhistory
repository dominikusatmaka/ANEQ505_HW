cat(sprintf("Thresholds — Leverage: %.4f | Cook's D: %.4f | Std Resid: |3|\n",
lev_threshold, cooks_threshold))
high_lev  <- which(leverage   > lev_threshold)
large_res <- which(abs(std_resid) > 3)
inf_obs   <- which(cooks_d    > cooks_threshold)
cat("High leverage observations:", ifelse(length(high_lev) == 0, "None",
paste0(high_lev, " (", df$Shift[high_lev], ")", collapse = ", ")), "\n")
cat("Outlier residuals (|r*|>3):", ifelse(length(large_res) == 0, "None",
paste(large_res, collapse = ", ")), "\n")
cat("Influential (Cook's D):", ifelse(length(inf_obs) == 0, "None",
paste0(inf_obs, " (", df$Shift[inf_obs], ")", collapse = ", ")), "\n")
par(mfrow = c(2, 2))
plot(m_diag, pch = 19, cex = 0.6,
col = ifelse(df$Shift == "Day", "#2171B5", "#C0504D"),
sub.caption = "Module 8: Influence Diagnostics — Stress Interaction Model")
par(mfrow = c(1, 1))
avPlots(m_diag, terms = ~ Stress_K10_c,
main = "Added-Variable Plot: Stress_K10 → EEQ (after adjusting others)")
ggplot() +
geom_col(aes(x = seq_along(cooks_d), y = cooks_d,
fill = df$Shift), alpha = 0.7) +
geom_hline(yintercept = cooks_threshold, linetype = "dashed", colour = "red") +
scale_fill_manual(values = c("#2171B5","#C0504D"), name = "Shift") +
labs(title = "Cook's Distance by Observation",
x = "Observation index", y = "Cook's D",
subtitle = paste("Red dashed = threshold (4/n =",
round(cooks_threshold, 4), ")")) +
theme_bw()
safe_eta_squared <- function(model, partial = FALSE) {
ss_table <- as.data.frame(summary(model)[[1]])
ss_resid  <- ss_table[grepl("Residuals|Error", rownames(ss_table)), "Sum Sq"][1]
ss_total  <- sum(ss_table[, "Sum Sq"])
effects   <- ss_table[!grepl("Residuals|Error", rownames(ss_table)), ]
}
run_oneway_anova <- function(dv, grp, shift_label, data = df) {
sub   <- data %>% filter(Shift == shift_label, !is.na(.data[[grp]]))
frm   <- as.formula(paste(dv, "~", grp))
lev_p <- leveneTest(frm, data = sub)$`Pr(>F)`[1]
cat(strrep("-", 50), "\n")
cat(sprintf("DV: %-14s | Group: %-16s | Shift: %s | Levene p=%.4f\n",
dv, grp, shift_label, lev_p))
if (!is.na(lev_p) && lev_p < .05) {
cat("→ Unequal variances → Welch ANOVA + Games-Howell\n")
print(oneway.test(frm, data = sub, var.equal = FALSE))
print(games_howell_test(sub, frm))
} else {
aov_res <- aov(frm, data = sub)
print(summary(aov_res))
cat("η² effect size:\n")
print(safe_eta_squared(aov_res, partial = FALSE))
cat("Tukey HSD:\n")
print(TukeyHSD(aov_res))
sub[[grp]] <- factor(sub[[grp]], levels = c("Low", "Moderate", "High"))
aov_c  <- aov(as.formula(paste(dv, "~", grp)), data = sub)
emm_c  <- emmeans(aov_c, as.formula(paste("~", grp)))
lin_con <- contrast(emm_c, list("Low vs High" = c(1, 0, -1)))
cat("Linear trend contrast (Low vs High):\n")
print(summary(lin_con))
}
cat("\n")
}
group_vars <- c("Stress_Tertile", "Burnout_Tertile", "Fatigue_Tertile")
for (shift in c("Day", "Night")) {
cat(sprintf("\n\n====== SHIFT: %s ======\n", shift))
for (grp in group_vars) {
for (dv in DVs) {
run_oneway_anova(dv, grp, shift)
}
}
}
