run_twoway_anova <- function(dv, grp_var, data = df) {
sub <- data %>% filter(!is.na(.data[[grp_var]]))
frm <- as.formula(paste(dv, "~", grp_var, "* Shift"))
aov2 <- aov(frm, data = sub)
cat(strrep("-", 50), "\n")
cat("DV:", dv, "~", grp_var, "* Shift\n")
cat("Type II ANOVA:\n")
print(Anova(aov2))
cat("Partial η²:\n")
print(safe_eta_squared(aov2, partial = TRUE))
emm <- emmeans(aov2, as.formula(paste("~", grp_var, "* Shift")))
cat("Estimated Marginal Means:\n")
print(emm)
cat("Pairwise contrasts (Tukey):\n")
print(contrast(emm, method = "pairwise", adjust = "tukey"))
cat("\n")
invisible(aov2)
}
for (grp in group_vars) {
cat(sprintf("\n\n====== Grouping: %s ======\n", grp))
for (dv in DVs) {
run_twoway_anova(dv, grp)
}
}
